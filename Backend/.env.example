# ---------- MySQL (Docker) ----------
# Credenciales de desarrollo local. En un servidor real, cambiarlas.
# root / root123 es el usuario con el que se entra a phpMyAdmin.
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=catalogo
MYSQL_USER=catalogo_user
MYSQL_PASSWORD=catalogo_local_2026
MYSQL_PORT=3307
MYSQL_HOST=127.0.0.1

# ---------- phpMyAdmin ----------
PHPMYADMIN_PORT=8081

# ---------- Backend ----------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------- IA (Etapa 3) ----------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELOS_RESPALDO=openai/gpt-oss-20b
IA_REASONING_EFFORT=medium
IA_REASONING_EFFORT_RESPUESTA=low
IA_TIMEOUT_MS=25000
IA_ESPERA_MAX_SEGUNDOS=12
TIENDA_NOMBRE=HardStore
IA_MAX_ITERACIONES=3
IA_MAX_TOKENS_SALIDA=2000

# ---------- Limites ----------
RATE_LIMIT_VENTANA_MS=60000
RATE_LIMIT_MAX=6
MENSAJE_MAX_CARACTERES=500
HISTORIAL_MAX_MENSAJES=20
HISTORIAL_MAX_CARACTERES=6000
